<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\native\skiasharp-dawn\Istok.SkiaSharp.NativeAssets.props" />

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <RootNamespace>Istok.SkiaSharp.NativeAssets.Linux</RootNamespace>
        <PackageId>Istok.SkiaSharp.NativeAssets.Linux</PackageId>
        <Description>Native SkiaSharp $(SkiaSharpVersion) binaries built with Graphite + Dawn (WebGPU) support for Linux (x64, arm64): libSkiaSharp.so (depends on Istok.WebGPU.Native.Linux for webgpu_dawn). Replaces SkiaSharp.NativeAssets.Linux: reference it directly with ExcludeAssets="all" so the stock libSkiaSharp is not deployed.</Description>
    </PropertyGroup>

</Project>
