<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Istok.WebGPU.View</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>true</IsPackable>
        <PackageId>Istok.WebGPU.View.Browser</PackageId>
        <Description>Blazor/Razor canvas view component for Istok.WebGPU (browser-wasm surface via HTML canvas).</Description>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Istok.WebGPU.View\Istok.WebGPU.View.csproj" />
        <ProjectReference Include="..\Istok.WebGPU\Istok.WebGPU.csproj" />
    </ItemGroup>
    
</Project>
