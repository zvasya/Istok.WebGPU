<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <WasmBuildNative>true</WasmBuildNative>
        <WasmCachePath>$(MSBuildProjectDirectory)/obj/emscripten-cache</WasmCachePath>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <RootNamespace>ExampleBrowser</RootNamespace>
        
    </PropertyGroup>

    <ItemGroup>
        <EmccExportedRuntimeMethod Include="WebGPU" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="11.0.0-rc.2.26504.105" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.2.26504.105" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-rc.2.26504.105" PrivateAssets="all" />
        <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.156.0-preview.1.26512.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Istok.WebGPU.View.Browser\Istok.WebGPU.View.Browser.csproj" />
        <ProjectReference Include="..\Examples\Examples.csproj" />
        <ProjectReference Include="..\..\Istok.WebGPU\Istok.WebGPU.csproj" />
    </ItemGroup>
    
    <Target Name="RegisterWgpuNativePInvokeModule" BeforeTargets="_GenerateManagedToNative">
        <ItemGroup>
            <_WasmPInvokeModules Include="webgpu_dawn" />
        </ItemGroup>
    </Target>

    <Target Name="CopyAssets" BeforeTargets="AssignTargetPaths">
        <ItemGroup>
            <AssetsSourceFiles Include="..\Assets\**\*.*" />
        </ItemGroup>
        <MakeDir Directories="wwwroot"/>
        <Copy
                SourceFiles="@(AssetsSourceFiles)"
                DestinationFolder="wwwroot/%(RecursiveDir)"
                SkipUnchangedFiles="true" />
    </Target>

</Project>
