<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ValidateXcodeVersion>false</ValidateXcodeVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.23.0"/>
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Assets\**\*.*">
            <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Istok.WebGPU.Native\Istok.WebGPU.Native.csproj" />
        <ProjectReference Include="..\..\Istok.WebGPU.View.SDL\Istok.WebGPU.View.SDL.csproj" />
        <ProjectReference Include="..\..\Istok.WebGPU.View\Istok.WebGPU.View.csproj" />
        <ProjectReference Include="..\Examples\Examples.csproj"/>
    </ItemGroup>

</Project>
