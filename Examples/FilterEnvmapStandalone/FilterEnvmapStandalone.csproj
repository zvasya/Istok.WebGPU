<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="ExamplesAssetsDirectory"
                          Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../Assets'))" />
        <PackageReference Include="StbImageSharp" Version="2.30.16" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../Examples/Examples.csproj" />
        <ProjectReference Include="../../Istok.WebGPU.Native.macOS/Istok.WebGPU.Native.macOS.csproj" />
        <ProjectReference Include="../../Istok.WebGPU.Native.Linux/Istok.WebGPU.Native.Linux.csproj" />
        <ProjectReference Include="../../Istok.WebGPU.Native.Win32/Istok.WebGPU.Native.Win32.csproj" />
    </ItemGroup>
</Project>
