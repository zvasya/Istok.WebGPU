<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0-ios</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <ValidateXcodeVersion>false</ValidateXcodeVersion>
    </PropertyGroup>
    
    <ItemGroup>
        <Content Include="..\Assets\**\*.*">
            <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Silk.NET.SDL" Version="2.23.0" />
<!--        <PackageReference Include="Silk.NET.Input.Sdl" Version="2.23.0" />-->
        <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.23.0"/>
        <!-- Stock libSkiaSharp has no Dawn backend; Istok.SkiaSharp.NativeAssets.iOS replaces it. -->
        <PackageReference Include="SkiaSharp.NativeAssets.iOS" Version="4.156.0-preview.1.26512.10" ExcludeAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Istok.WebGPU.Native.iOS\Istok.WebGPU.Native.iOS.csproj" />
        <ProjectReference Include="..\..\Istok.SkiaSharp.NativeAssets.iOS\Istok.SkiaSharp.NativeAssets.iOS.csproj" />
        <ProjectReference Include="..\Examples\Examples.csproj" />
        <ProjectReference Include="..\..\Istok.WebGPU.View.SDL\Istok.WebGPU.View.SDL.csproj" />
        <ProjectReference Include="..\..\Istok.WebGPU\Istok.WebGPU.csproj" />
    </ItemGroup>

    <Import Project="..\..\Istok.WebGPU.Native.iOS\Istok.WebGPU.Native.iOS.ProjectReference.targets" />
    <Import Project="..\..\Istok.SkiaSharp.NativeAssets.iOS\Istok.SkiaSharp.NativeAssets.iOS.ProjectReference.targets" />

</Project>
