<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationId>com.companyname.ExampleAndroid</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <!--
          Enables trim analyzers and full trimming during Release mode.
          To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
        -->
        <TrimMode>full</TrimMode>
    </PropertyGroup>


    <ItemGroup>
        <AndroidAsset Include="..\Assets\**\*.*">
            <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </AndroidAsset>
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.23.0" />
        <PackageReference Include="Xamarin.Essentials" Version="1.8.1" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\..\Istok.WebGPU.Native.Android\Istok.WebGPU.Native.Android.csproj" />
      <ProjectReference Include="..\..\Istok.WebGPU.View.SDL\Istok.WebGPU.View.SDL.csproj" />
      <ProjectReference Include="..\..\Istok.WebGPU\Istok.WebGPU.csproj" />
      <ProjectReference Include="..\Examples\Examples.csproj" />
    </ItemGroup>
</Project>