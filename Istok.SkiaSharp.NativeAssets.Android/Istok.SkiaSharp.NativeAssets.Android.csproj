<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\native\skiasharp-dawn\Istok.SkiaSharp.NativeAssets.props" />

    <PropertyGroup>
        <TargetFramework>net11.0-android</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <RootNamespace>Istok.SkiaSharp.NativeAssets.Android</RootNamespace>
        <PackageId>Istok.SkiaSharp.NativeAssets.Android</PackageId>
        <Description>Native SkiaSharp $(SkiaSharpVersion) binaries built with Graphite + Dawn (WebGPU) support for Android (arm64-v8a, armeabi-v7a, x86, x86_64): libSkiaSharp.so (depends on Istok.WebGPU.Native.Android for webgpu_dawn). Replaces SkiaSharp.NativeAssets.Android: reference it directly with ExcludeAssets="all" so the stock libSkiaSharp is not deployed.</Description>
    </PropertyGroup>

    <!--
      The package ships the .so files only via runtimes/ (like SkiaSharp.NativeAssets.Android), not again
      inside the .aar. Regular builds keep them in the .aar so ProjectReference consumers get them.
    -->
    <ItemGroup Condition="'$(_IsPacking)' == 'true'">
        <AndroidNativeLibrary Remove="@(AndroidNativeLibrary)" />
    </ItemGroup>

</Project>
