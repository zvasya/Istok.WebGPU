<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Istok.WebGPU.View</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>true</IsPackable>
        <PackageId>Istok.WebGPU.View.SDL</PackageId>
        <Description>SDL-based view (windowing/surface) for Istok.WebGPU built on Silk.NET.Windowing.Sdl.</Description>
    </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\Istok.WebGPU\Istok.WebGPU.csproj" />
        <ProjectReference Include="..\Istok.WebGPU.View\Istok.WebGPU.View.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.22.0" />
    </ItemGroup>

</Project>
