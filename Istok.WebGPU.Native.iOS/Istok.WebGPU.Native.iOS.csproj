<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0-ios</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Istok.WebGPU.Native.iOS</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageId>Istok.WebGPU.Native.iOS</PackageId>
        <Description>Native WebGPU runtime (Google Dawn, webgpu_dawn.framework) for iOS and the iOS simulator, packaged for use with Istok.WebGPU.</Description>
    </PropertyGroup>


    <ItemGroup>
        <None Include="runtimes\**\*" Exclude="**\.DS_Store" Pack="true" PackagePath="runtimes" />
    </ItemGroup>
    
</Project>
